PORT=3200
# Supabase -> Connect -> Session pooler (el host directo db.<ref>.supabase.co es solo IPv6)
DB_HOST=aws-0-us-east-2.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.<ref-del-proyecto>
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-secreta
JWT_EXPIRA=7d
# '*' o lista separada por comas
CORS_ORIGEN=*
# Días que dura una invitación
INVITACION_DIAS=7
URL_FRONTEND=http://localhost:4300
# Fotos de tickets (Cloudinary → Settings → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Correo para recuperar contraseña: webhook del flujo de n8n "Corcho — Enviar correo" (vacío = se imprime en consola)
N8N_CORREOS_URL=
# El mismo valor que espera el flujo en el header X-Correos-Token (openssl rand -base64 32)
N8N_CORREOS_TOKEN=
# Token que manda n8n en el header X-Integracion-Token (openssl rand -base64 32)
INTEGRACION_TOKEN=
