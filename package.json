{
  "name": "deudas-backend",
  "version": "1.0.0",
  "description": "Corcho: tablero de deudas y gastos personal o compartido (Express, Clean Architecture, Socket.IO, Postgres/Supabase)",
  "type": "module",
  "main": "src/main/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/main/server.js",
    "start": "node src/main/server.js",
    "db:migrate": "node src/infrastructure/database/migrate.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "e2e": "node scripts/e2e.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
